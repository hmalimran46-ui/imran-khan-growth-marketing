rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Site Content Document and Collection (Public Read, Authenticated/Admin Write)
    match /content/{contentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Messages Collection (Public Create for Contact Form, Authenticated Admin Read/Update/Delete)
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Diagnostics / Test Document
    match /test/{testId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

